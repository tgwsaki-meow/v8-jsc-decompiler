# ============================================================================
# NOT OURS -- must never be committed, and never to a public repository.
#
# These are Tencent's compiled code and the shipped QQ build. Publishing them
# would be redistributing proprietary software; they are inputs we analyse
# locally, not part of this tool. Everything the tool needs to be reproducible
# is derived from open-source V8 (see profiles/<tag>/meta.json).
# ============================================================================
extracted_jsc/
decompiled_js/
linuxQQ/
*.jsc
!tests/t8/fixtures/*.jsc
!corpus/**/*.jsc

# The read-only heap table and its provenance are derived from a shipped V8
# snapshot blob. The table itself is factual metadata about open-source V8
# objects and is reproducible in one command from a blob named with its sha256
# (docs/ARCHITECTURE.md 3.6), so it is committed; the blobs are not.
*.bin
!profiles/**/*.json

# ============================================================================
# Reproducible caches -- one command each, so they do not belong in git.
# ============================================================================

# Upstream V8 sources fetched by tools/profilegen. Every file is listed in
# profiles/<tag>/meta.json with its sha256 and URL.
.v8src-cache/

# Downloaded d8 / Electron builds, and the snapshots copied out of the QQ
# install. ~590 MB. tools/oracle/fetch_v8_binary.mjs and fetch_electron.mjs
# re-fetch the first two; the third comes from the machine being analysed.
.v8bin-cache/

node_modules/
*.log

# A profile + overlay generated for a *different build* of a V8 version that
# profiles/ already covers: the local node is built without pointer compression
# and without the sandbox, so its object layouts differ from the
# Electron/Chromium configuration that produced the corpus. tests/t4's oracle
# needs them; both are reproducible in one command each, recorded in
# docs/FRONTEND.md section 7.
profiles-local/
layouts-overlay-local/

# Artifacts of the T4 acceptance run: minted .jsc files and --print-bytecode
# listings, regenerated by `node tests/t4/acceptance.mjs`. The report it writes
# (tests/t4/ACCEPTANCE.txt) is kept.
tests/t4/out/

# ============================================================================
# Working directory. The reports are the output worth keeping; the per-file
# scan results (one JSON per corpus file, ~124 MB) are intermediates.
# ============================================================================
scratch/*
!scratch/*.mjs
!scratch/**/*.md
scratch/**/corpus/
scratch/*/out/
scratch/*/trial/
scratch/*/mint/
scratch/recon/v8src/

# ============================================================================
# Third-party and verbatim-upstream material, excluded on purpose.
# ============================================================================

# view8 is someone else's V8 decompiler (a separate project, with its own git
# repository nested here). It was read as prior art; it is not ours to
# redistribute. references/README.md says where to get it and is kept.
references/*
!references/README.md

# Verbatim V8 headers and .cc files copied in by the prototype. V8 is
# BSD-licensed so redistribution is permitted, but these are from
# **12.8.374.38** while the corpus is 14.4.258.16 (docs/ARCHITECTURE.md 1.2),
# they are what two wrong tables were derived from, and nothing reads them --
# tools/profilegen/selftest.mjs asserts exactly that. The correctly pinned
# sources are fetched on demand into .v8src-cache/ and recorded with a sha256
# in profiles/<tag>/meta.json.
rules/raw/
